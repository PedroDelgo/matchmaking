# Public client configuration only. Replace with your LOCAL API URL/public key.
# On a physical phone, 127.0.0.1 points to the phone: use the computer's private LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLIC_KEY
# Public URL of the Node tournament API. No database credentials or server key.
EXPO_PUBLIC_MATCHMAKING_API_URL=http://127.0.0.1:8090
