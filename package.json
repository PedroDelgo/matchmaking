{
  "name": "matchmaking",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.cjs",
    "check:deps": "expo install --check",
    "backend:typecheck": "tsc -p tsconfig.backend.json",
    "backend:build": "esbuild backend/src/server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=backend/dist/server.mjs",
    "backend:dev": "tsx --env-file=backend/.env backend/src/server.ts",
    "backend:test": "tsx --test backend/test/*.test.ts",
    "backend:test:db": "tsx --env-file-if-exists=backend/.env backend/test/run-database.ts",
    "db:start": "supabase db start",
    "db:migrate": "supabase migration up --local",
    "prebackend:test:db": "npm run backend:build",
    "auth:local": "node scripts/auth-local.mjs start",
    "api:local": "node scripts/auth-local.mjs api",
    "backend:test:auth": "node scripts/auth-local.mjs test",
    "backend:test:realtime": "node scripts/auth-local.mjs realtime",
    "backend:test:db:local": "node scripts/auth-local.mjs db",
    "test:auth:e2e": "node scripts/auth-local.mjs e2e"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "jose": "6.2.18",
    "jsqr": "1.4.0",
    "pg": "8.23.1",
    "prettier": "^3.10.1",
    "react-test-renderer": "^19.3.0",
    "supabase": "3.3.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  }
}
