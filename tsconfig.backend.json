{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "backend/**/*.ts",
    "src/features/tournaments/domain/**/*.ts",
    "src/features/tournaments/engine/**/*.ts"
  ]
}
